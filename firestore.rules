rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Correos con privilegios administrativos en Firestore (contenido, usuarios, etc.)
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == "sistemas.ti@bacarsa.com.ar"
          || request.auth.token.email == "admin@bacarsa.com.ar"
        );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function canManageUsers() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.super_admin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.manage_users == true
        );
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.super_admin == true;
    }

    // Admin de área (role explícito). Necesita listar users para asignar carpetas (Fase 2).
    function isAreaAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function callerManagedAreaIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedAreaIds;
    }

    function isAreaAdminOf(areaId) {
      return isAreaAdmin()
        && areaId is string
        && callerManagedAreaIds() is list
        && areaId in callerManagedAreaIds();
    }

    function folderRootAreaId(folderId) {
      return get(/databases/$(database)/documents/folders/$(folderId)).data.rootAreaId;
    }

    // Create de area admin: rootAreaId del hijo debe coincidir EXACTO con el del padre.
    function areaAdminCreatesUnderParent(parentId) {
      return parentId is string
        && exists(/databases/$(database)/documents/folders/$(parentId))
        && folderRootAreaId(parentId) is string
        && request.resource.data.rootAreaId == folderRootAreaId(parentId)
        && isAreaAdminOf(request.resource.data.rootAreaId);
    }

    function canManageContent() {
      return isAdmin() || isSuperAdmin();
    }

    function onlyFavoriteAppsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteApps']);
    }

    // Perfiles de usuario y permisos
    // get: propio doc, o Super Admin / Admin de área / emails hardcodeados
    // list: solo Super Admin / Admin de área / emails hardcodeados (no usuarios comunes)
    match /users/{userId} {
      allow get: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isSuperAdmin()
          || isAreaAdmin()
          || isAdmin()
        );
      allow list: if isSuperAdmin() || isAreaAdmin() || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if canManageUsers() || isAdmin()
        || (isAuthenticated() && request.auth.uid == userId && onlyFavoriteAppsUpdate());
      allow delete: if canManageUsers() || isAdmin();
    }

    // Noticias / comunicados
    match /news/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Enlaces útiles
    match /links/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Aplicaciones internas del dashboard (solo Super Admin)
    match /coreApps/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // Directorio de contactos (lectura pública para cumpleaños en landing)
    match /contacts/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Archivos compartidos de Google Drive
    match /sharedFiles/{document} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || canManageUsers();
    }

    function onlyPollVotesUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }

    // Encuestas rápidas
    match /polls/{document} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && onlyPollVotesUpdate());
    }

    // Pregunta del día (una por fecha)
    match /dailyQuestions/{document} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && onlyPollVotesUpdate());
    }

    // Reconocimientos (kudos)
    match /kudos/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Banners / popups
    match /banners/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Carpetas y recursos jerárquicos
    // PENDIENTE (alta prioridad / Prompt 3.1): allow read sigue abierto a cualquier
    // autenticado; allowedUsers / sharedWithAreaIds / rootAreaId aún no se aplican
    // en rules de lectura (solo en frontend). No cambiar en esta pasada.
    match /folders/{document} {
      allow read: if isAuthenticated();
      allow create: if canManageContent()
        || (
          isAreaAdmin()
          && request.resource.data.parentFolderId != null
          && areaAdminCreatesUnderParent(request.resource.data.parentFolderId)
        );
      allow update: if canManageContent()
        || canManageUsers()
        || (
          isAreaAdmin()
          && resource.data.rootAreaId is string
          && isAreaAdminOf(resource.data.rootAreaId)
          && request.resource.data.rootAreaId == resource.data.rootAreaId
        );
      allow delete: if canManageContent()
        || (
          isAreaAdmin()
          && resource.data.parentFolderId != null
          && resource.data.rootAreaId is string
          && isAreaAdminOf(resource.data.rootAreaId)
        );
    }

    match /resourceItems/{document} {
      allow read: if isAuthenticated();
      allow create: if canManageContent()
        || (
          isAreaAdmin()
          && request.resource.data.folderId != null
          && areaAdminCreatesUnderParent(request.resource.data.folderId)
        );
      allow update: if canManageContent()
        || canManageUsers()
        || (
          isAreaAdmin()
          && resource.data.rootAreaId is string
          && isAreaAdminOf(resource.data.rootAreaId)
          && request.resource.data.rootAreaId == resource.data.rootAreaId
        );
      allow delete: if canManageContent()
        || (
          isAreaAdmin()
          && resource.data.rootAreaId is string
          && isAreaAdminOf(resource.data.rootAreaId)
        );
    }

    // Configuración global de módulos
    match /global_settings/{document} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSuperAdmin();
    }

    // Turnos — jefe manual por semana (lunes a domingo)
    match /shiftJefeAssignments/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Rotación de Sistemas y excepciones puntuales
    match /shift_settings/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /shiftSystemsOverrides/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
