# Copiá a backend/.env para el emulador local. Nunca commitees .env ni JSON de claves.
#
# Prefijos reservados por Cloud Functions (no uses estos nombres en este archivo):
# FIREBASE_  GOOGLE_  X_GOOGLE_  EXT_
#
# Rutas a JSON (solo local): copiá backend/.env.local.example → backend/.env.local
# .env.local NO se despliega. Producción usa ADC + IAM signJwt (ver README).

# Email que se impersona vía Domain-Wide Delegation (no es un secreto criptográfico)
DRIVE_IMPERSONATE_EMAIL=datos@bacarsa.com.ar

# ID de la Unidad compartida fija (nunca se acepta driveId desde el cliente)
DRIVE_ID=

# Dominio permitido para tokens de Firebase Auth
ALLOWED_EMAIL_DOMAIN=bacarsa.com.ar

# --- Producción: backend/.env.bacar-web (gitignored, desplegado por Firebase CLI) ---
# DRIVE_SERVICE_ACCOUNT_EMAIL=datos-drive-sa@bacar-web.iam.gserviceaccount.com
# BOARDS_CONTAINER_FOLDER_ID=
# BOARDS_SESSION_SECRET=
