# Copiá a backend/.env.local — solo emulador/scripts locales.
# Este archivo NO se despliega a Cloud Functions (Firebase lo ignora en deploy).

# Admin SDK (verifyIdToken, Firestore): cuenta firebase-adminsdk del proyecto.
ADMIN_SDK_KEY_PATH=C:\Users\Admin\.bacarsa\firebase-admin-sa.json

# Cliente Drive + DWD: datos-drive-sa@bacar-web.iam.gserviceaccount.com
DRIVE_SERVICE_ACCOUNT_KEY_PATH=C:\Users\Admin\.bacarsa\datos-drive-sa.json
